# URL do servidor (sem o sufixo /api, pois os caminhos OpenAPI já incluem esse prefixo).
VITE_API_URL=http://localhost:8000

# Ative somente para desenvolvimento local com MSW.
VITE_ENABLE_MOCKS=true

# Login Microsoft (Entra ID > Registros de aplicativo). A redirect URI deve bater com
# MICROSOFT_REDIRECT_URI no backend (ex.: http://localhost:5173/auth/microsoft/callback).
# VITE_MICROSOFT_TENANT_ID=
# VITE_MICROSOFT_CLIENT_ID=
# VITE_MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback
